$ PROGRAM INFORMATION
  PROGRAM  "ETABS"  VERSION "21.0.0"
$ CONTROLS
  UNITS  "KN"  "M"  "C"
$ STORIES - IN SEQUENCE FROM TOP
  STORY "Roof"  HEIGHT 3.2
  STORY "GF"  HEIGHT 3.5
  STORY "Base"  ELEV 0
$ MATERIAL PROPERTIES
  MATERIAL  "C32"  TYPE "Concrete"  WEIGHTPERVOLUME 25
  MATERIAL  "C32"  FC 32000
$ FRAME SECTIONS
  FRAMESECTION  "C50x50"  MATERIAL "C32"  SHAPE "Concrete Rectangular"  D 0.5  B 0.5
$ WALL/SLAB/DECK PROPERTIES
  SHELLPROP  "FS24"  PROPTYPE  "Slab"  MATERIAL "C32"  SLABTYPE "Slab"  SLABTHICKNESS 0.24
$ POINT COORDINATES
  POINT "1"  0 0
  POINT "2"  7 0
  POINT "3"  14 0
  POINT "4"  0 6
  POINT "5"  7 6
  POINT "6"  14 6
  POINT "7"  0 12
  POINT "8"  7 12
  POINT "9"  14 12
$ LINE CONNECTIVITIES
  LINE  "C1"  COLUMN  "1"  "1"  1
  LINE  "C2"  COLUMN  "2"  "2"  1
  LINE  "C3"  COLUMN  "3"  "3"  1
  LINE  "C4"  COLUMN  "4"  "4"  1
  LINE  "C5"  COLUMN  "5"  "5"  1
  LINE  "C6"  COLUMN  "6"  "6"  1
  LINE  "C7"  COLUMN  "7"  "7"  1
  LINE  "C8"  COLUMN  "8"  "8"  1
  LINE  "C9"  COLUMN  "9"  "9"  1
$ AREA CONNECTIVITIES
  AREA "F1"  FLOOR  4  "1"  "3"  "9"  "7"  0  0  0  0
$ POINT ASSIGNS
  POINTASSIGN  "1"  "Base"  RESTRAINT "UX UY UZ RX RY RZ"
  POINTASSIGN  "2"  "Base"  RESTRAINT "UX UY UZ RX RY RZ"
  POINTASSIGN  "3"  "Base"  RESTRAINT "UX UY UZ RX RY RZ"
  POINTASSIGN  "4"  "Base"  RESTRAINT "UX UY UZ RX RY RZ"
  POINTASSIGN  "5"  "Base"  RESTRAINT "UX UY UZ RX RY RZ"
  POINTASSIGN  "6"  "Base"  RESTRAINT "UX UY UZ RX RY RZ"
  POINTASSIGN  "7"  "Base"  RESTRAINT "UX UY UZ RX RY RZ"
  POINTASSIGN  "8"  "Base"  RESTRAINT "UX UY UZ RX RY RZ"
  POINTASSIGN  "9"  "Base"  RESTRAINT "UX UY UZ RX RY RZ"
$ LINE ASSIGNS
  LINEASSIGN  "C1"  "GF"  SECTION "C50x50"
  LINEASSIGN  "C2"  "GF"  SECTION "C50x50"
  LINEASSIGN  "C3"  "GF"  SECTION "C50x50"
  LINEASSIGN  "C4"  "GF"  SECTION "C50x50"
  LINEASSIGN  "C5"  "GF"  SECTION "C50x50"
  LINEASSIGN  "C6"  "GF"  SECTION "C50x50"
  LINEASSIGN  "C7"  "GF"  SECTION "C50x50"
  LINEASSIGN  "C8"  "GF"  SECTION "C50x50"
  LINEASSIGN  "C9"  "GF"  SECTION "C50x50"
  LINEASSIGN  "C1"  "Roof"  SECTION "C50x50"
  LINEASSIGN  "C2"  "Roof"  SECTION "C50x50"
  LINEASSIGN  "C3"  "Roof"  SECTION "C50x50"
  LINEASSIGN  "C4"  "Roof"  SECTION "C50x50"
  LINEASSIGN  "C5"  "Roof"  SECTION "C50x50"
  LINEASSIGN  "C6"  "Roof"  SECTION "C50x50"
  LINEASSIGN  "C7"  "Roof"  SECTION "C50x50"
  LINEASSIGN  "C8"  "Roof"  SECTION "C50x50"
  LINEASSIGN  "C9"  "Roof"  SECTION "C50x50"
$ AREA ASSIGNS
  AREAASSIGN  "F1"  "GF"  SECTION "FS24"
  AREAASSIGN  "F1"  "Roof"  SECTION "FS24"
$ LOAD PATTERNS
  LOADPATTERN "Dead"  TYPE  "Dead"  SELFWEIGHT  1
  LOADPATTERN "SDL"  TYPE  "Super Dead"  SELFWEIGHT  0
  LOADPATTERN "Live"  TYPE  "Live"  SELFWEIGHT  0
$ AREA LOADS
  AREALOAD  "F1"  "GF"  TYPE "UNIFLOAD"  DIR "GRAV"  LC "SDL"  FVAL 2.5
  AREALOAD  "F1"  "GF"  TYPE "UNIFLOAD"  DIR "GRAV"  LC "Live"  FVAL 3
  AREALOAD  "F1"  "Roof"  TYPE "UNIFLOAD"  DIR "GRAV"  LC "SDL"  FVAL 2.5
  AREALOAD  "F1"  "Roof"  TYPE "UNIFLOAD"  DIR "GRAV"  LC "Live"  FVAL 3
$ LOAD COMBINATIONS
  COMBO "U1"  TYPE "Linear Add"
  COMBO "U1"  LOAD "Dead"  SF 1.4
  COMBO "U1"  LOAD "SDL"  SF 1.4
  COMBO "U1"  LOAD "Live"  SF 1.6
  END
